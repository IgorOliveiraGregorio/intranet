{
  "name": "intranet-auth",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de login para intranet: Express + SQLite + JWT com refresh tokens rotativos",
  "main": "src/server.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "gen-secret": "node -e \"console.log(require('crypto').randomBytes(48).toString('base64url'))\"",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "better-sqlite3": "^11.7.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
