# Copie para .env e ajuste. NUNCA versione o arquivo .env.
NODE_ENV=development
PORT=3000

# Gere com: npm run gen-secret  (mínimo de 32 caracteres)
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-gerado-com-gen-secret
JWT_ISSUER=intranet-auth
JWT_AUDIENCE=intranet-app
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

DB_PATH=./data/app.db

# Origens autorizadas (CORS e verificação de Origin anti-CSRF), separadas por vírgula.
# Deve incluir a URL exata pela qual os usuários acessam o sistema.
ALLOWED_ORIGINS=http://localhost:3000

# Número de proxies reversos à frente da aplicação (0 = nenhum).
TRUST_PROXY=0

# Cookie "Secure" (exige HTTPS). Padrão: true em produção. Só use false se a intranet for HTTP puro.
# COOKIE_SECURE=true

# Custo do Argon2id (OWASP: m=19456 KiB, t=2, p=1 como mínimo recomendado)
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2

# Limitação de tentativas (janela em ms)
LOGIN_WINDOW_MS=900000
LOGIN_MAX_ATTEMPTS_PER_ACCOUNT=5
LOGIN_MAX_ATTEMPTS_PER_IP=20
REGISTER_MAX_PER_HOUR=10

LOG_LEVEL=info
